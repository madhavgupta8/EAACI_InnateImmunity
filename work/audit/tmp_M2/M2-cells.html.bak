</g>
<g><rect x="275" y="44" width="250" height="150" rx="8" fill="#f5f7fa" stroke="#2e7d5b" stroke-width="1.5"/>
<rect x="275" y="44" width="250" height="30" rx="8" fill="#2e7d5b"/><rect x="275" y="59" width="250" height="15" fill="#2e7d5b"/>
<text x="285" y="65" class="t-head t-white">Macrophage</text>
