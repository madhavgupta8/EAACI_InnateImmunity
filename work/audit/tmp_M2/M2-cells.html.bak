</g>
<g><rect x="538" y="44" width="250" height="150" rx="8" fill="#f5f7fa" stroke="#1f5f8b" stroke-width="1.5"/>
<rect x="538" y="44" width="250" height="30" rx="8" fill="#1f5f8b"/><rect x="538" y="59" width="250" height="15" fill="#1f5f8b"/>
<text x="548" y="65" class="t-head t-white">Dendritic cell</text>
<text x="548" y="96" class="t-body">All: CD11c; need FLT3L</text>
<text x="548" y="116" class="t-body">cDC1: CD141, XCR1 → CD8 T</text>
